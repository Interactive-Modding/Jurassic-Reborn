{
  "multipart": [
    {
      "when": { "connections": 0, "pole": "false" },
      "apply": { "model": "jurassicreborn:block/low_security_fence_base" }
    },
    {
      "when": {
        "OR": [
          { "connections": 4, "north": "true", "pole": "false" },
          { "connections": 4, "south": "true", "pole": "false" }
        ]
      },
      "apply": { "model": "jurassicreborn:block/low_security_fence_base_lower", "y": 0 }
    },
    {
      "when": {
        "OR": [
          { "connections": 4, "west": "true", "pole": "false" },
          { "connections": 4, "east": "true", "pole": "false" }
        ]
      },
      "apply": { "model": "jurassicreborn:block/low_security_fence_base", "y": 90 }
    },
    {
      "when": {
        "OR": [
          { "connections": 1, "west": "true",  "east": "false", "pole": "false" },
          { "connections": 1, "east": "true",  "west": "false", "pole": "false" },
          { "connections": 2, "west": "true",  "east": "true",  "pole": "false" }
        ]
      },
      "apply": { "model": "jurassicreborn:block/low_security_fence_base" }
    },
    {
      "when": {
        "OR": [
          { "connections": 1, "north": "true", "south": "false", "pole": "false" },
          { "connections": 1, "south": "true", "north": "false", "pole": "false" },
          { "connections": 2, "north": "true", "south": "true",  "pole": "false" }
        ]
      },
      "apply": { "model": "jurassicreborn:block/low_security_fence_base", "y": 90 }
    },
    {
      "when": { "connections": 3, "north": "true", "west": "true", "south": "true", "pole": "false" },
      "apply": { "model": "jurassicreborn:block/low_security_fence_base_corner" }
    },
    {
      "when": { "connections": 3, "north": "true", "west": "true", "south": "true", "pole": "false" },
      "apply": { "model": "jurassicreborn:block/low_security_fence_base_corner_lower", "y": 90 }
    },
    {
      "when": { "connections": 3, "north": "true", "east": "true", "south": "true", "pole": "false" },
      "apply": { "model": "jurassicreborn:block/low_security_fence_base_corner", "y": 180 }
    },
    {
      "when": { "connections": 3, "north": "true", "east": "true", "south": "true", "pole": "false" },
      "apply": { "model": "jurassicreborn:block/low_security_fence_base_corner_lower", "y": 270 }
    },
    {
      "when": { "connections": 3, "east": "true", "north": "true", "west": "true", "pole": "false" },
      "apply": { "model": "jurassicreborn:block/low_security_fence_base_corner" }
    },
    {
      "when": { "connections": 3, "east": "true", "north": "true", "west": "true", "pole": "false" },
      "apply": { "model": "jurassicreborn:block/low_security_fence_base_corner_lower", "y": 270 }
    },
    {
      "when": { "connections": 3, "east": "true", "south": "true", "west": "true", "pole": "false" },
      "apply": { "model": "jurassicreborn:block/low_security_fence_base_corner", "y": 90 }
    },
    {
      "when": { "connections": 3, "east": "true", "south": "true", "west": "true", "pole": "false" },
      "apply": { "model": "jurassicreborn:block/low_security_fence_base_corner_lower", "y": 180 }
    },
    {
      "when": { "connections": 2, "north": "true", "east": "true", "pole": "false" },
      "apply": { "model": "jurassicreborn:block/low_security_fence_base_corner", "y": 270 }
    },
    {
      "when": { "connections": 2, "east": "true",  "south": "true", "pole": "false" },
      "apply": { "model": "jurassicreborn:block/low_security_fence_base_corner", "y": 180 }
    },
    {
      "when": { "connections": 2, "south": "true", "west":  "true", "pole": "false" },
      "apply": { "model": "jurassicreborn:block/low_security_fence_base_corner", "y": 90 }
    },
    {
      "when": { "connections": 2, "north": "true", "west":  "true", "pole": "false" },
      "apply": { "model": "jurassicreborn:block/low_security_fence_base_corner" }
    },
    {
      "when": { "pole": "true" },
      "apply": { "model": "jurassicreborn:block/low_security_fence_base_pole" }
    }
  ]
}
