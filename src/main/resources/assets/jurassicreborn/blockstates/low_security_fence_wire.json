    },
    {
      "when": {"east": "true", "up": "down"},
      "apply": {"model": "jurassicreborn:block/low_security_fence_wire"}
    },
    {
      "when": {"south": "true", "up": "down"},
      "apply": {"model": "jurassicreborn:block/low_security_fence_wire", "y": 90}
    },
    {
      "when": {"west": "true", "up": "down"},
      "apply": {"model": "jurassicreborn:block/low_security_fence_wire", "y": 180}
    },
    {
      "when": {"up": "north"},
      "apply": {"model": "jurassicreborn:block/low_security_fence_wire_diagonal", "y": 270}
    },
    {
      "when": {"up": "east"},
      "apply": {"model": "jurassicreborn:block/low_security_fence_wire_diagonal"}
    },
    {
      "when": {"up": "south"},
      "apply": {"model": "jurassicreborn:block/low_security_fence_wire_diagonal", "y": 90}
